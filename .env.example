POSTGRES_DB=riskdb
POSTGRES_USER=riskuser
POSTGRES_PASSWORD=change-this-db-password

# Base64-encoded key used for JWT signing (generate a strong one for production)
JWT_SECRET=replace-with-base64-secret
JWT_EXPIRATION=3600000

APP_VERSION=1.0.0

# Keep false in production unless you intentionally want a seeded admin user
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password

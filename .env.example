SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5463/riskdb
SPRING_DATASOURCE_USERNAME=riskuser
SPRING_DATASOURCE_PASSWORD=your_db_password_here

JWT_SECRET=replace_with_a_secure_base64_or_random_secret
JWT_EXPIRATION=3600000

APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change_me

SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false
LOGGING_LEVEL_SPRING_SECURITY=INFO
APP_VERSION=dev
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
